{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mementomori settings v1",
  "type": "object",
  "required": ["app", "version", "state", "widget"],
  "properties": {
    "app": { "const": "mementomori" },
    "version": { "const": 1 },
    "state": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["seconds", "days"] },
        "profile": {
          "type": ["object", "null"],
          "required": ["birthday", "years"],
          "properties": {
            "birthday": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "years": { "type": "number", "minimum": 1, "maximum": 120 }
          }
        },
        "intention": {
          "type": ["object", "null"],
          "required": ["text", "date"],
          "properties": {
            "text": { "type": "string", "maxLength": 100 },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        }
      }
    },
    "widget": {
      "type": "object",
      "required": ["variant", "theme"],
      "properties": {
        "variant": { "enum": ["wide", "square", "slim"] },
        "theme": { "enum": ["dark", "light"] }
      }
    }
  }
}
